# === RAHASIA — jangan pernah commit file .env ===
# Secret HMAC 32-byte dari Dashboard -> Rotate Secret (tampil sekali).
AGENT_GAMES_HMAC_SECRET=

# Salt rahasia strategi Anda (dipakai untuk commitment Poseidon).
# Jangan pernah bagikan / log / commit nilainya.
STRATEGY_SALT=

# === STRATEGI (RAHASIA) ===
# TODO(STRATEGY): isi 8 parameter strategi Anda sendiri dalam bentuk JSON array.
# Format circuit: [extractAmount(1..10), fortifyIfSelfBelow, holdIfOppAtMost, alwaysHold(0/1), 0, 0, 0, 0]
# Elemen 4..7 WAJIB 0 sesuai sirkuit resmi.
# Isi dengan parameter ANDA sendiri — tidak ada nilai contoh di sini dengan sengaja.
STRATEGY_PARAMS=

# === Opsional ===
PORT=8787
PROOF_TIMEOUT_MS=15000

# zkVerify submission opsional (audit pointer saja; TIDAK boleh mem-blok response turn).
ZKVERIFY_SUBMIT=false
ZKVERIFY_SUBMIT_TIMEOUT_MS=2000
KURIER_API_KEY=
